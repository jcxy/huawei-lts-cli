{
  "name": "@cvtoolman/huawei-lts-cli",
  "version": "2.0.0",
  "description": "Command-line tool for querying Huawei Cloud Log Tank Service (LTS) logs",
  "main": "dist/cli/index.js",
  "bin": {
    "lts-cli": "dist/cli/index.js"
  },
  "files": [
    "dist/"
  ],
  "scripts": {
    "build": "tsc",
    "dev": "tsx src/cli/index.ts",
    "start": "node dist/cli/index.js",
    "test": "node --import tsx --test \"test/**/*.test.ts\"",
    "typecheck": "tsc --noEmit",
    "clean": "node -e \"require('fs').rmSync('dist', {recursive: true, force: true})\"",
    "prepublishOnly": "npm run clean && npm run build"
  },
  "keywords": [
    "huawei-cloud",
    "huawei",
    "lts",
    "log-tank-service",
    "logs",
    "cli",
    "log-query",
    "cloud-logging"
  ],
  "author": "cvtoolman",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jcxy/huawei-lts-cli.git"
  },
  "bugs": {
    "url": "https://github.com/jcxy/huawei-lts-cli/issues"
  },
  "homepage": "https://github.com/jcxy/huawei-lts-cli#readme",
  "engines": {
    "node": ">=18.0.0"
  },
  "dependencies": {
    "@huaweicloud/huaweicloud-sdk-core": "^3.1.200",
    "@huaweicloud/huaweicloud-sdk-lts": "^3.1.200",
    "chalk": "^4.1.2",
    "cli-table3": "^0.6.5",
    "commander": "^15.0.0",
    "uuid": "^9.0.0"
  },
  "devDependencies": {
    "@types/node": "^26.0.0",
    "tsx": "^4.22.4",
    "typescript": "^6.0.3"
  }
}
